# Copiar a .env y completar. Nunca subir .env al repositorio.
NODE_ENV=development
PORT=3000
# Origen público de la web (CORS, enlaces de recuperación y retorno de Mercado Pago)
WEB_ORIGIN=http://localhost:5173

# Obligatorios en producción: cadenas largas y aleatorias (por ejemplo: openssl rand -base64 48)
SESSION_SECRET=
QR_SECRET=

# Base de datos y archivos (por defecto dentro de server/)
# DB_FILE=/var/lib/cooperarios/cooperarios.db
# UPLOADS_DIR=/var/lib/cooperarios/uploads
# BACKUPS_DIR=/var/backups/cooperarios

# Mercado Pago (sin token, los pagos funcionan en modo simulado)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Correo institucional (recuperación de contraseña y avisos)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Club Los Cooperarios <no-responder@cooperariosclub.com.ar>"
